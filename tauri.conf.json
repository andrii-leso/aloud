{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aloud",
  "version": "0.1.0",
  "identifier": "com.andriileso.aloud",
  "build": { "frontendDist": "dist" },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Aloud Settings",
        "width": 480,
        "height": 700,
        "resizable": false,
        "visible": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": { "csp": null },
    "macOSPrivateApi": false,
    "withGlobalTauri": true
  },
  "bundle": { "active": true, "targets": ["dmg"], "icon": ["icons/icon.png"] }
}
