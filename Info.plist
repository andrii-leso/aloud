<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The single source of truth for the NSServices declaration. Merged
       into target/Aloud.app's bundle Info.plist by packaging/make-app.sh
       (PlistBuddy `Merge`) — NOT by the Tauri CLI bundler, which this
       project deliberately does not use for macOS packaging (see
       CLAUDE.md's Stack section for why). Keep this file containing only
       what make-app.sh should merge wholesale into the bundle plist.

       NSMessage is the selector STEM: "readSelection" means macOS invokes
       -readSelection:userData:error: on the registered services provider.
       If the two ever disagree the Service silently never fires — no error,
       no log. Keep this string and the #[unsafe(method(...))] attribute in
       src/selection/macos.rs in lockstep. -->
  <key>NSServices</key>
  <array>
    <dict>
      <key>NSMenuItem</key>
      <dict><key>default</key><string>Read Aloud</string></dict>
      <key>NSMessage</key>
      <string>readSelection</string>
      <key>NSPortName</key>
      <string>Aloud</string>
      <key>NSSendTypes</key>
      <array><string>NSStringPboardType</string></array>
    </dict>
  </array>
</dict>
</plist>
